# Todos los archivos de texto se guardan en el repo con finales de linea LF,
# sin importar el sistema operativo ni el core.autocrlf de cada uno.
# Convencion acordada en la review del 2026-10-01.
* text=auto eol=lf

# Binarios: git no debe tocarles los bytes
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
